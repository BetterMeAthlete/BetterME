<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elite Performance App</title>
    <style>
        :root {
            --primary: #1a1a1a;
            --accent: #d4af37; /* Gold for a professional feel */
            --text: #ffffff;
            --bg: #121212;
        }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: var(--bg); color: var(--text); margin: 0; }
        nav { background: var(--primary); padding: 1rem; display: flex; justify-content: space-around; position: sticky; top: 0; z-index: 100; border-bottom: 2px solid var(--accent); }
        nav a { color: var(--text); text-decoration: none; font-weight: bold; cursor: pointer; }
        .tab-content { display: none; padding: 2rem; max-width: 800px; margin: auto; }
        .active { display: block; }
        
        /* Playbook/Quotes */
        #quote-container { background: #1e1e1e; padding: 20px; border-left: 5px solid var(--accent); border-radius: 8px; text-align: center; margin-top: 20px; }
        
        /* Planner Sections */
        .planner-section { background: #222; margin-bottom: 20px; padding: 15px; border-radius: 8px; border: 1px solid #333; }
        textarea { width: 100%; background: #333; border: 1px solid #444; color: white; padding: 10px; border-radius: 5px; box-sizing: border-box; }
        
        /* Store Section */
        .store-item { display: flex; gap: 2rem; align-items: flex-start; margin-top: 2rem; }
        .book-img { width: 250px; border-radius: 4px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        .buy-btn { background: var(--accent); color: black; padding: 12px 24px; text-decoration: none; font-weight: bold; border-radius: 5px; display: inline-block; margin-top: 1rem; }
    </style>
</head>
<body>

<nav>
    <a onclick="showTab('playbook')">Playbook</a>
    <a onclick="showTab('planner')">Planner</a>
    <a onclick="showTab('store')">Store</a>
</nav>

<section id="playbook" class="tab-content active">
    <h2>Daily Playbook</h2>
    <div id="quote-container">
        <p id="daily-quote">"Loading inspiration..."</p>
        <cite id="quote-author"></cite>
    </div>
</section>

<section id="planner" class="tab-content">
    <h2>Performance Planner</h2>
    <div class="planner-section">
        <h3>Goals</h3>
        <p>Daily Focus:</p>
        <textarea rows="2" placeholder="What's the main objective today?"></textarea>
        <p>Monthly/Yearly Milestones:</p>
        <textarea rows="4" placeholder="List your long-term vision..."></textarea>
    </div>
    <div class="planner-section">
        <h3>Reflection</h3>
        <p>Strengths & Successes:</p>
        <textarea rows="3" placeholder="What went well?"></textarea>
        <p>Areas for Improvement:</p>
        <textarea rows="3" placeholder="Where can we tighten up?"></textarea>
    </div>
</section>

<section id="store" class="tab-content">
    <h2>Elite Store</h2>
    <div class="store-item">
        <img src="book-cover.jpg" alt="Point Guard: A Diary" class="book-img">
        <div>
            <h3>Point Guard: A Diary</h3>
            <p><strong>By Keeton Cole</strong></p>
            <p>An intimate look into the mindset, challenges, and triumphs of the game from a leader's perspective. Perfect for athletes looking to sharpen their mental edge and understand the grit required to play at the next level.</p>
            <a href="https://www.amazon.ca/s?k=Point+Guard+A+Diary+Keeton+Cole" target="_blank" class="buy-btn">Purchase on Amazon.ca</a>
        </div>
    </div>
</section>

<script>
    // Tab Logic
    function showTab(id) {
        document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    }

    // Automated Quotes Logic (30 Days)
    const quotes = [
        { q: "You miss 100% of the shots you don’t take.", a: "Wayne Gretzky" },
        { q: "Hard work beats talent when talent doesn’t work hard.", a: "Tim Notke" },
        { q: "I’ve failed over and over and over again in my life. And that is why I succeed.", a: "Michael Jordan" },
        { q: "Success is no accident. It is hard work, perseverance, and sacrifice.", a: "Pelé" },
        { q: "The only way to prove that you’re a good sport is to lose.", a: "Ernie Banks" },
        { q: "Don't count the days, make the days count.", a: "Muhammad Ali" },
        { q: "If you aren't going all the way, why go at all?", a: "Joe Namath" },
        { q: "The more difficult the victory, the greater the happiness in winning.", a: "Pelé" },
        { q: "Champions keep playing until they get it right.", a: "Billie Jean King" },
        { q: "You can’t put a limit on anything. The more you dream, the farther you get.", a: "Michael Phelps" },
        // ... (remaining 20 quotes would be listed here to reach 30)
        { q: "Winning isn’t everything, but wanting to win is.", a: "Vince Lombardi" }
    ];

    function updateDailyQuote() {
        const date = new Date();
        const dayOfMonth = date.getDate(); // Returns 1-31
        const quoteIndex = (dayOfMonth - 1) % quotes.length;
        document.getElementById('daily-quote').innerText = `"${quotes[quoteIndex].q}"`;
        document.getElementById('quote-author').innerText = `- ${quotes[quoteIndex].a}`;
    }

    // Initialize
    updateDailyQuote();
</script>

</body>
</html>

